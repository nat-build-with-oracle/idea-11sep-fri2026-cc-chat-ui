{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARRA Claude Code Server",
  "version": "0.1.0",
  "identifier": "com.buildwithoracle.arra-claude-code-server",
  "build": {
    "beforeBuildCommand": "npm run tauri:resources",
    "beforeDevCommand": "npm run dev:client",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Local Claude Code chat backend",
    "longDescription": "Runs the ARRA Claude Code local backend and opens its dashboard from the macOS menu bar.",
    "resources": { "../.local/tauri-runtime": "app" },
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
